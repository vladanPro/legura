import { RichTextEditor } from "@/components/RichTextEditor"
import { Input } from "@axonyx/ui/foundry/Input"
import { Textarea } from "@axonyx/ui/foundry/Textarea"
import { Select } from "@axonyx/ui/foundry/Select"
import { Field } from "@axonyx/ui/foundry/Field"
import { FieldLabel } from "@axonyx/ui/foundry/FieldLabel"

component PostFields(title = "", slug = "", body = "", status = "draft", format = "plain-text", document = "") {
  return ASX {
    <Field htmlFor="title">
      <FieldLabel htmlFor="title">Title</FieldLabel>
      <Input id="title" name="title" value={title} maxlength="160" describedBy="title-error" />
      <p id="title-error" data-ax-field-error="title" role="alert"></p>
    </Field>
    <Field htmlFor="slug">
      <FieldLabel htmlFor="slug">URL slug</FieldLabel>
      <Input id="slug" name="slug" value={slug} maxlength="120" describedBy="slug-error" />
      <p id="slug-error" data-ax-field-error="slug" role="alert"></p>
    </Field>
    <input type="hidden" name="content_format" value={format} />
    <Field htmlFor="body">
    <If when={format == "plain-text"}>
      <FieldLabel htmlFor="body">Content</FieldLabel>
      <Textarea id="body" name="body" value={body} maxlength="20000" rows="12" />
      <p>Plain text. This existing post will not be converted automatically.</p>
    </If>
    <If when={format == "legura-richtext"}>
      <input type="hidden" name="body" value="" />
      <RichTextEditor label="Content" document={document} fallback={body} />
      <noscript>Rich content is read-only without JavaScript. Create a plain-text post instead.</noscript>
    </If>
    <p data-ax-field-error="body" role="alert"></p>
    <p data-ax-field-error="content_document" role="alert"></p>
    <p data-ax-field-error="content_format" role="alert"></p>
    </Field>
    <Field htmlFor="status">
    <FieldLabel htmlFor="status">Status</FieldLabel>
    <Select id="status" name="status" describedBy="status-error">
      <option value="draft" selected={status == "draft"}>Draft</option>
      <option value="published" selected={status == "published"}>Published</option>
    </Select>
    <p id="status-error" data-ax-field-error="status" role="alert"></p>
    </Field>
  }
}
