action PreparePost(content_format: String, body: String, content_document: String = "") {
  data bearer = Auth.bearer
  require bearer == "isolated-proof" else forbidden()
  data prepared = Native.call("legura.content.prepare", {content_format: input.content_format, body: input.body, content_document: input.content_document})
  require prepared["columns"] != null else invalid(prepared["errors"])
  data acknowledged = Native.call("legura.proof.persist", prepared["columns"])
  return acknowledged
}
