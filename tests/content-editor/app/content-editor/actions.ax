action CreateEditorPost(slug: String, content_format: String, body: String, content_document: String = "") {
  data administrator = loadAdministrator()
  require input.slug != "" else invalid({slug: "Enter a URL slug."})
  data prepared = Native.call("legura.content.prepare", {content_format: input.content_format, body: input.body, content_document: input.content_document})
  require prepared.columns != null else invalid(prepared.errors)
  data id = Uuid.new()
  db.legura_posts.insert({id: id, title: "Editor proof", slug: input.slug, body: prepared.columns.body, status: "draft", content_format: prepared.columns.content_format, content_document: prepared.columns.content_document})
  return redirect("/admin/content-editor/edit?slug=" + input.slug)
}
