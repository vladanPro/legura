import { Card } from "@axonyx/ui/foundry/Card"
import { Copy } from "@axonyx/ui/foundry/Copy"
import { PublicFrame } from "@/components/PublicFrame"

page Home() {
  data appearance: PublicAppearance = loadPublicAppearance()
  data navigation: PublicNavigation = loadPublicNavigation()
  data language: PublicLocale = loadPublicLocale(query.lang ?? "")
  data identity: PublicSiteIdentity = loadPublicSiteIdentity()
  const translate = I18n.withLocale(language.locale)
  return ASX {
    <PublicFrame
      theme={appearance.theme}
      colorMode={appearance.color_mode}
      palette={appearance.resolved_palette}
      headerAssigned={navigation.header_assigned}
      hasHeader={navigation.has_header}
      hasFooter={navigation.has_footer}
      headerItems={navigation.header}
      footerItems={navigation.footer}
      locale={language.locale}
      switcher={language.switcher}
      suffix={language.suffix}
      siteTitle={identity.title}
      tagline={identity.tagline}
      icon={identity.icon}
    >
      <Card title={translate("public.welcome")}>
        <Copy>{translate("public.welcome.hint")}</Copy>
        <nav class="legura-links">
          <a href={"/posts" + language.suffix}>{translate("public.posts")}</a>
          <a href="/setup">{translate("public.setup")}</a>
          <a href="/login">{translate("public.login")}</a>
          <a href="/admin">{translate("public.admin")}</a>
        </nav>
      </Card>
    </PublicFrame>
  }
}
