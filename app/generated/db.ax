export type LeguraCredentialsRow {
  user_id: String
  email: String
  password_hash: String
}

export type LeguraCredentialsCreateInput {
  user_id: String
  email: String
  password_hash: String
}

export type LeguraCredentialsUpdateInput {
  user_id: Optional<String>
  email: Optional<String>
  password_hash: Optional<String>
}

export type LeguraInstallationRow {
