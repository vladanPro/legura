  site_name: String
  admin_id: String
}

export type LeguraInstallationCreateInput {
  id: Optional<Int>
  site_name: String
  admin_id: String
}

export type LeguraInstallationUpdateInput {
  id: Optional<Int>
  site_name: Optional<String>
  admin_id: Optional<String>
}

