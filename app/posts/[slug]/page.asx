import { PostStory } from "@/components/PostStory"
import { PublicFrame } from "@/components/PublicFrame"

page PublicPost() {
  data appearance: PublicAppearance = loadPublicAppearance()
  data navigation: PublicNavigation = loadPublicNavigation()
  data contentLanguage: String = loadSiteContentLanguage()
  data post: PublishedStory = loadPublishedPost(params.slug)
  data categories: PublicCategoryLink[] = loadPublicPostCategories(params.slug)
  data language: PublicLocale = loadPublicLocale(query.lang ?? "")
  data identity: PublicSiteIdentity = loadPublicSiteIdentity()
  const translate = I18n.withLocale(language.locale)
  return ASX {
    <Head>
      <Title>{post.title + " | " + identity.title}</Title>
      <Meta name="description" content={post.description} />
      <Link rel="canonical" href={post.canonical} />
    </Head>
    <PublicFrame
      theme={appearance.theme}
      finish={appearance.finish}
      colorMode={appearance.color_mode}
      palette={appearance.resolved_palette}
      headerAssigned={navigation.header_assigned}
      hasHeader={navigation.has_header}
      hasFooter={navigation.has_footer}
      headerItems={navigation.header}
      footerItems={navigation.footer}
      locale={language.locale}
      switcher={language.switcher}
      suffix={language.suffix}
      siteTitle={identity.title}
      tagline={identity.tagline}
      icon={identity.icon}
      currentPath={"/posts/" + params.slug}
    >
      <If when={categories}>
        <nav class="legura-links" aria-label={translate("public.categories")}>
          <Each items={categories} as="category">
            <a href={"/categories/" + category.slug + language.suffix} lang={contentLanguage}>{category.name}</a>
          </Each>
        </nav>
      </If>
      <PostStory
        title={post.title}
        body={post.body}
        backHref={"/posts" + language.suffix}
        backLabel={translate("public.posts.all")}
        unavailableLabel={translate("public.image.unavailable")}
        contentLanguage={contentLanguage}
        contentHtml={post.html}
        imageSelected={post.imageSelected}
        imageSrc={post.imageSrc}
        imageAlt={post.imageAlt}
      />
    </PublicFrame>
  }
}
