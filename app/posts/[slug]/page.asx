import { PostStory } from "@/components/PostStory"

page PublicPost() {
  data post: PublishedStory = loadPublishedPost(params.slug)
  return ASX {
    <PostStory
      title={post.title}
      body={post.body}
      contentHtml={post.html}
      imageSelected={post.imageSelected}
      imageSrc={post.imageSrc}
      imageAlt={post.imageAlt}
    />
  }
}
