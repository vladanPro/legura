import { Card } from "@axonyx/ui/foundry/Card"
import { PublicFrame } from "@/components/PublicFrame"

page PublicPosts() {
  data publicTheme: String = loadPublicTheme()
  data navigation: PublicNavigation = loadPublicNavigation()
  data posts: Post[] = loadPublishedPosts()
  data language: PublicLocale = loadPublicLocale(query.lang ?? "")
  data contentLanguage: String = loadSiteContentLanguage()
  const translate = I18n.withLocale(language.locale)
  return ASX {
    <PublicFrame
      theme={publicTheme}
      headerAssigned={navigation.header_assigned}
      hasHeader={navigation.has_header}
      hasFooter={navigation.has_footer}
      headerItems={navigation.header}
      footerItems={navigation.footer}
      locale={language.locale}
      switcher={language.switcher}
      suffix={language.suffix}
      currentPath="/posts"
    >
      <section class="legura-posts">
        <h1>{translate("public.posts")}</h1>
        <If when={!posts}>
          <Card title={translate("public.posts.empty")}>
            <p>{translate("public.posts.empty.hint")}</p>
          </Card>
        </If>
        <div class="legura-post-list">
          <Each items={posts} as="post">
            <Card>
              <h2 lang={contentLanguage}>{post.title}</h2>
              <a href={"/posts/" + post.slug + language.suffix}>{translate("public.posts.read")}</a>
            </Card>
          </Each>
        </div>
      </section>
    </PublicFrame>
  }
}
