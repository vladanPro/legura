import { AppShell } from "@axonyx/ui/foundry/AppShell"
import { Sidebar } from "@axonyx/ui/foundry/Sidebar"
import { SidebarHeader } from "@axonyx/ui/foundry/SidebarHeader"
import { SidebarSection } from "@axonyx/ui/foundry/SidebarSection"
import { SidebarItem } from "@axonyx/ui/foundry/SidebarItem"

component AdminFrame(section = "overview") {
  return ASX {
    <AppShell class="legura-admin-shell" mode="embedded" railWidth="sm">
      <Sidebar slot="sidebar" label="Administration navigation" collapsible="true" open="true">
        <SidebarHeader slot="header">
          <strong>Workspace</strong>
        </SidebarHeader>
        <nav class="legura-admin-nav" aria-label="Administration">
          <SidebarItem href="/admin" active={section == "overview"}>Overview</SidebarItem>
          <SidebarSection title="Content">
            <SidebarItem href="/admin/posts" active={section == "posts"}>Manage posts</SidebarItem>
            <SidebarItem href="/admin/pages" active={section == "pages"}>Pages</SidebarItem>
            <SidebarItem href="/admin/media" active={section == "media"}>Media</SidebarItem>
          </SidebarSection>
          <SidebarSection title="Website">
            <SidebarItem href="/admin/settings" active={section == "settings"}>Settings</SidebarItem>
            <SidebarItem href="/admin/appearance" active={section == "appearance"}>Appearance</SidebarItem>
            <SidebarItem href="/admin/navigation" active={section == "navigation"}>Navigation</SidebarItem>
            <SidebarItem href="/admin/language" active={section == "language"}>Language</SidebarItem>
            <SidebarItem href="/">View public site</SidebarItem>
          </SidebarSection>
          <SidebarSection title="Account">
            <SidebarItem href="/admin/profile" active={section == "profile"}>Profile</SidebarItem>
          </SidebarSection>
        </nav>
      </Sidebar>
      <div class="ax-layout-main legura-admin-content">
        <Slot />
      </div>
    </AppShell>
  }
}
