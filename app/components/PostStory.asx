component PostStory(title = "", body = "", contentHtml = "", backHref = "/posts", backLabel = "All posts", imageSelected = false, imageSrc = "", imageAlt = "", contentLanguage = "en", unavailableLabel = "Featured image is unavailable.") {
  return ASX {
    <article class="legura-story">
      <a href={backHref}>{backLabel}</a>
      <h1 lang={contentLanguage}>{title}</h1>
      <If when={imageSrc != ""}>
        <img
          class="legura-story__image"
          data-post-featured-image="true"
          src={imageSrc}
          alt={imageAlt}
          lang={contentLanguage}
        />
      </If>
      <If when={imageSelected && imageSrc == ""}>
        <div class="legura-media-placeholder" data-post-image-unavailable="true">{unavailableLabel}</div>
      </If>
      <If when={contentHtml != ""}>
        <div lang={contentLanguage}>
          <Html class="legura-story__body" content={contentHtml} />
        </div>
      </If>
      <If when={contentHtml == ""}>
        <div class="legura-story__body" lang={contentLanguage}>{body}</div>
      </If>
    </article>
  }
}
