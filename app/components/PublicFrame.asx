import { Container } from "@axonyx/ui/foundry/Container"
import { PublicMenu } from "@/components/PublicMenu"

component PublicFrame(theme = "default", headerAssigned = 0, hasHeader = false, hasFooter = false, headerItems = [], footerItems = []) {
  return ASX {
    <If when={theme == "editorial"}>
      <div
        class="legura-public"
        data-legura-public-theme="editorial"
        data-foundry="bronze"
        data-foundry-style="alloy"
        data-foundry-mode="light"
      >
        <a class="legura-skip-link" href="#main-content">Skip to content</a>
        <Container max="xl">
          <header class="legura-header legura-public-header">
            <a class="legura-brand" href="/"><img src="/legura-mark.svg" alt="" width="36" height="36" />Legura</a>
            <If when={headerAssigned == 0}>
              <nav class="legura-editorial-nav" aria-label="Public navigation">
                <a href="/">Home</a>
                <a href="/posts">Stories</a>
              </nav>
            </If>
            <If when={hasHeader}>
              <PublicMenu items={headerItems} />
            </If>
          </header>
          <div class="legura-main" id="main-content" tabindex="-1">
            <Slot />
          </div>
          <If when={hasFooter}>
            <footer class="legura-public-footer">
              <PublicMenu items={footerItems} label="Footer navigation" />
            </footer>
          </If>
        </Container>
      </div>
    </If>
    <If when={theme != "editorial"}>
      <div
        class="legura-public"
        data-legura-public-theme="default"
        data-foundry="silver"
        data-foundry-style="classic"
        data-foundry-mode="light"
      >
        <a class="legura-skip-link" href="#main-content">Skip to content</a>
        <Container max="lg">
          <header class="legura-header legura-public-header">
            <a class="legura-brand" href="/"><img src="/legura-mark.svg" alt="" width="36" height="36" />Legura</a>
            <If when={headerAssigned == 0}>
              <span>Content, forged together.</span>
            </If>
            <If when={hasHeader}>
              <PublicMenu items={headerItems} />
            </If>
          </header>
          <div class="legura-main" id="main-content" tabindex="-1">
            <Slot />
          </div>
          <If when={hasFooter}>
            <footer class="legura-public-footer">
              <PublicMenu items={footerItems} label="Footer navigation" />
            </footer>
          </If>
        </Container>
      </div>
    </If>
  }
}
