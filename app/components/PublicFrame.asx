import { Container } from "@axonyx/ui/foundry/Container"

component PublicFrame(theme = "default") {
  return ASX {
    <If when={theme == "editorial"}>
      <div
        class="legura-public"
        data-legura-public-theme="editorial"
        data-foundry="bronze"
        data-foundry-style="alloy"
        data-foundry-mode="light"
      >
        <a class="legura-skip-link" href="#main-content">Skip to content</a>
        <Container max="xl">
          <header class="legura-header legura-public-header">
            <a class="legura-brand" href="/"><img src="/assets/legura-mark.svg" alt="" width="36" height="36" />Legura</a>
            <nav class="legura-editorial-nav" aria-label="Public navigation">
              <a href="/">Home</a>
              <a href="/posts">Stories</a>
            </nav>
          </header>
          <div class="legura-main" id="main-content" tabindex="-1">
            <Slot />
          </div>
        </Container>
      </div>
    </If>
    <If when={theme != "editorial"}>
      <div
        class="legura-public"
        data-legura-public-theme="default"
        data-foundry="silver"
        data-foundry-style="classic"
        data-foundry-mode="light"
      >
        <a class="legura-skip-link" href="#main-content">Skip to content</a>
        <Container max="lg">
          <header class="legura-header legura-public-header">
            <a class="legura-brand" href="/"><img src="/assets/legura-mark.svg" alt="" width="36" height="36" />Legura</a>
            <span>Content, forged together.</span>
          </header>
          <div class="legura-main" id="main-content" tabindex="-1">
            <Slot />
          </div>
        </Container>
      </div>
    </If>
  }
}
