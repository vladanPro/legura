component MediaPlaceholder(label = "No image selected") {
  return ASX {
    <div class="legura-media-placeholder" role="img" aria-label={label}>
      <svg
        width="48"
        height="48"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="8" cy="9" r="1.5" />
        <path d="m4 17 5-5 4 4 3-3 4 4" />
      </svg>
      <span aria-hidden="true">{label}</span>
    </div>
  }
}
