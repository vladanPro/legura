import { Button } from "@axonyx/ui/foundry/Button"
import { Card } from "@axonyx/ui/foundry/Card"
import { Field } from "@axonyx/ui/foundry/Field"
import { FieldHint } from "@axonyx/ui/foundry/FieldHint"
import { FieldLabel } from "@axonyx/ui/foundry/FieldLabel"
import { Input } from "@axonyx/ui/foundry/Input"
import { Select } from "@axonyx/ui/foundry/Select"

component AddUserForm(submitAction = "") {
  return ASX {
    <section id="add-user" aria-labelledby="add-user-title">
      <Card>
        <h2 id="add-user-title">Add user</h2>
        <p>Create an Editor or Subscriber account. Legura does not send email invitations.</p>
        <form
          method="post"
          action={submitAction}
          class="legura-form"
          data-ax-retain-fields="email,role"
        >
          <Field>
            <FieldLabel htmlFor="email">Email</FieldLabel>
            <Input id="email" name="email" type="email" required="true" describedBy="email-error" />
            <p
              id="email-error"
              class="ax-field__error"
              data-ax-field-error="email"
              aria-live="polite"
            ></p>
          </Field>
          <Field>
            <FieldLabel htmlFor="role">Role</FieldLabel>
            <Select id="role" name="role" required="true" describedBy="role-hint role-error">
              <option value="subscriber">Subscriber</option>
              <option value="editor">Editor</option>
            </Select>
            <FieldHint id="role-hint">Editors manage posts and pages. Subscribers cannot access the admin area.</FieldHint>
            <p
              id="role-error"
              class="ax-field__error"
              data-ax-field-error="role"
              aria-live="polite"
            ></p>
          </Field>
          <Field>
            <FieldLabel htmlFor="password">Initial password</FieldLabel>
            <input
              class="ax-input"
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="10"
              maxlength="256"
              required="true"
              aria-describedby="password-hint password-error"
            />
            <FieldHint id="password-hint">Use 10 to 256 characters and share the password securely with the user.</FieldHint>
            <p
              id="password-error"
              class="ax-field__error"
              data-ax-field-error="password"
              aria-live="polite"
            ></p>
          </Field>
          <div class="legura-form-actions">
            <Button type="submit" variant="primary">Create user</Button>
          </div>
        </form>
      </Card>
    </section>
  }
}
