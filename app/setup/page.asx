import { Card } from "@axonyx/ui/foundry/Card"
import { Button } from "@axonyx/ui/foundry/Button"

page Setup() {
  data title: String = loadSetup()
  return ASX {
    <Card title={title}>
      <p>You need the one-time setup token configured by the server owner.</p>
      <form method="post" action={action Install} data-ax-retain-fields="siteName,email" class="legura-form">
        <label class="ax-field-label" for="siteName">Site name</label>
        <input class="ax-input" id="siteName" name="siteName" required="true" maxlength="120" />
        <p class="ax-field__error" data-ax-field-error="siteName"></p>
        <label class="ax-field-label" for="email">Administrator email</label>
        <input class="ax-input" id="email" name="email" type="email" required="true" autocomplete="username" />
        <p class="ax-field__error" data-ax-field-error="email"></p>
        <label class="ax-field-label" for="password">Password</label>
        <input class="ax-input" id="password" name="password" type="password" required="true" autocomplete="new-password" />
        <p class="ax-field__error" data-ax-field-error="password"></p>
        <label class="ax-field-label" for="setupToken">Setup token</label>
        <input class="ax-input" id="setupToken" name="setupToken" type="password" required="true" autocomplete="off" />
        <Button type="submit" variant="primary">Create installation</Button>
      </form>
    </Card>
  }
}
