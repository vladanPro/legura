import { Card } from "@axonyx/ui/foundry/Card"
import { Button } from "@axonyx/ui/foundry/Button"

page Login() {
  return ASX {
    <Card title="Sign in to Legura">
      <form method="post" action={action SignIn} data-ax-retain-fields="email" class="legura-form">
        <label class="ax-field-label" for="email">Email</label>
        <input class="ax-input" id="email" name="email" type="email" autocomplete="username" required="true" />
        <p class="ax-field__error" data-ax-field-error="email"></p>
        <label class="ax-field-label" for="password">Password</label>
        <input class="ax-input" id="password" name="password" type="password" autocomplete="current-password" required="true" />
        <Button type="submit" variant="primary">Sign in</Button>
      </form>
    </Card>
  }
}
