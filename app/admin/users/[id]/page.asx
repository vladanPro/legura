import { AdminFrame } from "@/components/AdminFrame"
import { AdminPageHeader } from "@/components/AdminPageHeader"
import { Card } from "@axonyx/ui/foundry/Card"

page UserAccountDetails() {
  data user: UserAccount = loadUserAccount(params.id)
  return ASX {
    <AdminFrame section="users">
      <AdminPageHeader title="User account" description="Account details and its current role." />
      <Card>
        <dl class="legura-profile-details">
          <dt>Email</dt>
          <dd>{user.email}</dd>
          <dt>Role</dt>
          <dd>{user.role}</dd>
        </dl>
        <a href="/admin/users">Back to users</a>
      </Card>
    </AdminFrame>
  }
}
