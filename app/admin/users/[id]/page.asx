import { AdminFrame } from "@/components/AdminFrame"
import { AdminPageHeader } from "@/components/AdminPageHeader"
import { Button } from "@axonyx/ui/foundry/Button"
import { Card } from "@axonyx/ui/foundry/Card"
import { Field } from "@axonyx/ui/foundry/Field"
import { FieldLabel } from "@axonyx/ui/foundry/FieldLabel"
import { Select } from "@axonyx/ui/foundry/Select"
import { TextLink } from "@axonyx/ui/foundry/TextLink"

page UserAccountDetails() {
  data user: UserAccount = loadUserAccount(params.id)
  return ASX {
    <AdminFrame section="users">
      <AdminPageHeader title="User account" description="Account details and its current role." />
      <Card>
        <dl class="legura-profile-details">
          <dt>Email</dt>
          <dd>{user.email}</dd>
          <dt>Role</dt>
          <dd>{user.role}</dd>
        </dl>
        <If when={user.role == "editor" || user.role == "subscriber"}>
          <form method="post" action={action UpdateUserRole} class="legura-form">
            <input type="hidden" name="id" value={user.id} />
            <Field>
              <FieldLabel htmlFor="role">New role</FieldLabel>
              <Select id="role" name="role" required="true" describedBy="role-error">
                <option value="subscriber" selected={user.role == "subscriber"}>Subscriber</option>
                <option value="editor" selected={user.role == "editor"}>Editor</option>
              </Select>
              <p
                id="role-error"
                class="ax-field__error"
                data-ax-field-error="role"
                aria-live="polite"
              ></p>
            </Field>
            <div class="legura-form-actions">
              <Button type="submit" variant="primary">Save role</Button>
            </div>
          </form>
        </If>
        <TextLink href="/admin/users">Back to users</TextLink>
      </Card>
    </AdminFrame>
  }
}
