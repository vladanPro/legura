action SelectPublicTheme(theme: String) {
  data administrator = loadAdministrator()
  require input.theme == "default" || input.theme == "editorial" else invalid({ theme: "Choose an installed public theme." })
  db.legura_public_theme.where({ id: 1 }).update({ theme: input.theme })
  return redirect("/admin/appearance")
}

action SetPublicColorMode(color_mode: String) {
  data administrator = loadAdministrator()
  require input.color_mode == "light" || input.color_mode == "dark" else invalid({ color_mode: "Choose Light or Dark." })
  db.legura_public_theme.where({ id: 1 }).update({ color_mode: input.color_mode })
  return redirect("/admin/appearance")
}

action SetPublicPalette(palette: String) {
  data administrator = loadAdministrator()
  require input.palette == "theme" || input.palette == "silver" || input.palette == "bronze" || input.palette == "gold" else invalid({ palette: "Choose Theme default, Silver, Bronze, or Gold." })
  db.legura_public_theme.where({ id: 1 }).update({ palette: input.palette })
  return redirect("/admin/appearance")
}
