import { Button } from "@axonyx/ui/foundry/Button"
import { Card } from "@axonyx/ui/foundry/Card"
import { Select } from "@axonyx/ui/foundry/Select"
import { AdminFrame } from "@/components/AdminFrame"

page Appearance() {
  data appearance: PublicAppearance = loadPublicAppearance()
  data administrator: Administrator = loadAdministrator()
  return ASX {
    <AdminFrame section="appearance">
      <header class="legura-page-heading">
        <div>
          <h1>Public theme</h1>
          <p>Choose the look and layout visitors see. Your administration stays unchanged.</p>
        </div>
        <a class="ax-button" data-variant="secondary" href="/posts">View public site</a>
      </header>
      <div class="legura-theme-choices">
        <Card title="Default">
          <p>A clean, centered reading layout. Uses Silver by default.</p>
          <If when={appearance.theme == "default"}>
            <p class="legura-theme-active">Active theme</p>
          </If>
          <If when={appearance.theme != "default"}>
            <form method="post" action={action SelectPublicTheme}>
              <input type="hidden" name="theme" value="default" />
              <Button type="submit" variant="secondary">Activate Default</Button>
            </form>
          </If>
        </Card>
        <Card title="Editorial">
          <p>A wider, magazine-like reading layout. Uses Bronze by default.</p>
          <If when={appearance.theme == "editorial"}>
            <p class="legura-theme-active">Active theme</p>
          </If>
          <If when={appearance.theme != "editorial"}>
            <form method="post" action={action SelectPublicTheme}>
              <input type="hidden" name="theme" value="editorial" />
              <Button type="submit" variant="secondary">Activate Editorial</Button>
            </form>
          </If>
        </Card>
      </div>
      <Card title="Public color mode">
        <p id="public-color-mode-hint">Applies to the public site, not the admin panel. Changing the theme keeps this setting.</p>
        <form method="post" action={action SetPublicColorMode} class="legura-form">
          <label for="public-color-mode">Color mode</label>
          <Select
            id="public-color-mode"
            name="color_mode"
            describedBy="public-color-mode-hint public-color-mode-error"
          >
            <option value="light" selected={appearance.color_mode == "light"}>Light</option>
            <option value="dark" selected={appearance.color_mode == "dark"}>Dark</option>
          </Select>
          <p
            id="public-color-mode-error"
            class="ax-field__error"
            data-ax-field-error="color_mode"
            aria-live="polite"
          ></p>
          <Button type="submit" variant="primary">Save color mode</Button>
        </form>
      </Card>
      <Card title="Public palette">
        <p id="public-palette-hint">Choose colors for the public site without changing its layout or Light/Dark mode.</p>
        <form method="post" action={action SetPublicPalette} class="legura-form">
          <label for="public-palette">Color palette</label>
          <Select
            id="public-palette"
            name="palette"
            describedBy="public-palette-hint public-palette-error"
          >
            <option value="theme" selected={appearance.palette == "theme"}>Theme default</option>
            <option value="silver" selected={appearance.palette == "silver"}>Silver</option>
            <option value="bronze" selected={appearance.palette == "bronze"}>Bronze</option>
            <option value="gold" selected={appearance.palette == "gold"}>Gold</option>
          </Select>
          <p
            id="public-palette-error"
            class="ax-field__error"
            data-ax-field-error="palette"
            aria-live="polite"
          ></p>
          <Button type="submit" variant="primary">Save palette</Button>
        </form>
      </Card>
      <p class="legura-hint">Signed in as {administrator.email}. These two themes ship with Legura; uploading third-party themes is not available yet.</p>
    </AdminFrame>
  }
}
