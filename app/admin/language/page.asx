import { AdminFrame } from "@/components/AdminFrame"
import { Card } from "@axonyx/ui/foundry/Card"
import { Select } from "@axonyx/ui/foundry/Select"

page LanguageSettings() {
  data preferences: LanguagePreferences = loadLanguagePreferences()
  const translate = I18n.withLocale(preferences.admin_language)
  return ASX {
    <AdminFrame section="language">
      <section lang={preferences.admin_language}>
        <header class="legura-page-heading">
          <div>
            <h1>{translate("language.title")}</h1>
            <p>{translate("language.description")}</p>
          </div>
        </header>
        <Card>
          <form method="post" action={action SetAdminLanguage} class="legura-form">
            <label for="admin-language">{translate("language.admin.label")}</label>
            <Select
              id="admin-language"
              name="admin_language"
              describedBy="admin-language-hint admin-language-error"
            >
              <option value="en" lang="en" selected={preferences.admin_language == "en"}>English</option>
              <option
                value="sr-Latn"
                lang="sr-Latn"
                selected={preferences.admin_language == "sr-Latn"}
              >Srpski (latinica)</option>
            </Select>
            <p id="admin-language-hint" class="legura-hint">
              {translate("language.admin.hint")}
            </p>
            <p
              id="admin-language-error"
              class="ax-field__error"
              data-ax-field-error="admin_language"
              aria-live="polite"
            ></p>
            <button type="submit" class="ax-button" data-variant="primary">
              {translate("language.admin.save")}
            </button>
          </form>
        </Card>
        <Card>
          <form method="post" action={action SetSiteLanguage} class="legura-form">
            <label for="site-language">{translate("language.site.label")}</label>
            <Select
              id="site-language"
              name="site_language"
              describedBy="site-language-hint site-language-error"
            >
              <option value="en" lang="en" selected={preferences.site_language == "en"}>English</option>
              <option
                value="sr-Latn"
                lang="sr-Latn"
                selected={preferences.site_language == "sr-Latn"}
              >Srpski (latinica)</option>
            </Select>
            <p id="site-language-hint" class="legura-hint">
              {translate("language.site.hint")}
            </p>
            <p
              id="site-language-error"
              class="ax-field__error"
              data-ax-field-error="site_language"
              aria-live="polite"
            ></p>
            <button type="submit" class="ax-button" data-variant="primary">
              {translate("language.site.save")}
            </button>
          </form>
        </Card>
        <Card title={translate("language.interface.title")}>
          <form method="post" action={action SetPublicInterfaceLanguage} class="legura-form">
            <label for="interface-language">{translate("language.interface.default")}</label>
            <Select
              id="interface-language"
              name="interface_language"
              describedBy="interface-language-error"
            >
              <option value="en" lang="en" selected={preferences.interface_language == "en"}>English</option>
              <option value="fr" lang="fr" selected={preferences.interface_language == "fr"}>{t("public.switch.fr")}</option>
            </Select>
            <p
              id="interface-language-error"
              class="ax-field__error"
              data-ax-field-error="interface_language"
              aria-live="polite"
            ></p>
            <label for="interface-switcher">{translate("language.interface.switcher")}</label>
            <Select
              id="interface-switcher"
              name="interface_switcher"
              describedBy="interface-switcher-error"
            >
              <option value="0" selected={preferences.interface_switcher == 0}>{translate("language.interface.disabled")}</option>
              <option value="1" selected={preferences.interface_switcher == 1}>{translate("language.interface.enabled")}</option>
            </Select>
            <p
              id="interface-switcher-error"
              class="ax-field__error"
              data-ax-field-error="interface_switcher"
              aria-live="polite"
            ></p>
            <p class="legura-hint">{translate("language.interface.hint")}</p>
            <button type="submit" class="ax-button" data-variant="primary">{translate("language.interface.save")}</button>
          </form>
        </Card>
      </section>
    </AdminFrame>
  }
}
