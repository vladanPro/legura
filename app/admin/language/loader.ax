export type LanguagePreferences {
  admin_language: String
  site_language: String
}

export query loadLanguagePreferences() -> LanguagePreferences {
  require Auth.subject else forbidden()
  data administrator = db.legura_users.where({ id: Auth.subject }).first()
  require administrator else forbidden()
  require administrator["role"] == "admin" else forbidden()
  data preferences = db.legura_languages.where({ id: 1 }).first()
  return { admin_language: preferences["admin_language"], site_language: preferences["site_language"] }
}
