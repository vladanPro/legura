export type Post {
  id: String
  title: String
  slug: String
  body: String
  status: String
}
export type AdminPostListItem {
  id: String
  title: String
  slug: String
  status: String
  author: String?
  created_at: String?
  created_label: String?
}
export type PostCategoryFilter {
  id: String
  name: String
}
export type AdminPostPage {
  posts: AdminPostListItem[]
  page: Number
  total: Number
  status: String
  search: String
  category: String
  category_available: Bool
  categories: PostCategoryFilter[]
  timezone: String
  can_delete: Bool
}
export query loadAdminPosts(status: String = "all", page: String = "1", search: String = "", category: String = "") -> AdminPostPage {
  require Auth.subject else forbidden()
  data administrator = db.legura_users.where({ id: Auth.subject }).first()
  require administrator else forbidden()
  data allowed = Native.call("legura.auth.allows", { role: administrator["role"], capability: "manage_content" })
  require allowed else forbidden()
  require input.category.length <= 128 else notFound()
  data filters = Native.call("legura.posts.filters", { status: input.status, page: input.page, search: input.search })
  data categories = db.query("SELECT id,name FROM legura_categories ORDER BY name COLLATE NOCASE,id")
  data selectedCategory = db.legura_categories.where({ id: input.category }).first()
  data counts = db.query("SELECT COUNT(*) AS total FROM legura_posts p WHERE p.trashed = (? = 'trash') AND (? IN ('all', 'trash') OR p.status = ?) AND instr(lower(p.title), lower(?)) > 0 AND (? = '' OR EXISTS(SELECT 1 FROM legura_post_categories pc WHERE pc.post_id=p.id AND pc.category_id=?))", filters.status, filters.status, filters.status, filters.search, input.category, input.category)
  data pagination = Native.call("legura.pagination", { total: counts[0]["total"], requested_page: filters.requested_page, page_size: 10 })
  data posts = db.query("SELECT p.id, p.title, p.slug, p.status, u.email AS author, p.created_at FROM legura_posts p LEFT JOIN legura_users u ON u.id = p.created_by WHERE p.trashed = (? = 'trash') AND (? IN ('all', 'trash') OR p.status = ?) AND instr(lower(p.title), lower(?)) > 0 AND (? = '' OR EXISTS(SELECT 1 FROM legura_post_categories pc WHERE pc.post_id=p.id AND pc.category_id=?)) ORDER BY p.title ASC, p.id ASC LIMIT ? OFFSET ?", filters.status, filters.status, filters.status, filters.search, input.category, input.category, pagination.page_size, pagination.offset)
  data preferences = db.legura_general_settings.where({ id: 1 }).first()
  data formatted = Native.call("legura.posts.format_dates", { posts: posts, timezone: preferences["timezone"], date_format: preferences["date_format"], time_format: preferences["time_format"] })
  return { posts: formatted, page: pagination.page, total: counts[0]["total"], status: filters.status, search: filters.search, category: input.category, category_available: input.category == "" || selectedCategory != null, categories: categories, timezone: preferences["timezone"], can_delete: administrator["role"] == "admin" }
}

export type PostImageTarget {
  id: String
  title: String
  image_id: String
  image_alt: String
}

export query loadPostImageTarget(id: String) -> PostImageTarget {
  require Auth.subject else forbidden()
  data administrator = db.legura_users.where({ id: Auth.subject }).first()
  require administrator else forbidden()
  require administrator["role"] == "admin" else forbidden()
  data post = db.legura_posts.where({ id: input.id, trashed: 0 }).first()
  require post else notFound()
  data images = db.query("SELECT COALESCE((SELECT media_id FROM legura_post_images WHERE post_id = ?), '') AS image_id, COALESCE((SELECT alt FROM legura_post_images WHERE post_id = ?), '') AS image_alt", input.id, input.id)
  return { id: post["id"], title: post["title"], image_id: images[0]["image_id"], image_alt: images[0]["image_alt"] }
}
