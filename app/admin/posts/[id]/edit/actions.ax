import { validatePost } from "../../../../domain/posts.ax"

action UpdatePost(id: String, title: String, slug: String, body: String, status: String) {
  data administrator = loadAdministrator()
  data post = db.legura_posts.where({ id: input.id }).first()
  require post else notFound()
  data validation = validatePost(input.title, input.slug, input.body, input.status)
  require validation.title else invalid({ title: validation.titleError })
  require validation.slug else invalid({ slug: validation.slugError })
  require validation.body else invalid({ body: validation.bodyError })
  require validation.status else invalid({ status: validation.statusError })
  data existing = db.legura_posts.where({ slug: input.slug }).first()
  require existing == null || existing["id"] == input.id else invalid({ slug: "This URL slug is already in use. Choose another." })
  db.legura_posts.where({ id: input.id }).update({ title: input.title, slug: input.slug, body: input.body, status: input.status })
  return redirect("/admin/posts")
}
