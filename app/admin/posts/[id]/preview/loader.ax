export type SavedPostPreview {
  id: String
  title: String
  body: String
  status: String
  html: String
}
export query loadSavedPostPreview(id: String) -> SavedPostPreview {
  require Auth.subject else forbidden()
  data administrator = db.legura_users.where({ id: Auth.subject }).first()
  require administrator else forbidden()
  require administrator["role"] == "admin" else forbidden()
  data post = db.legura_posts.where({ id: input.id }).first()
  require post else notFound()
  data rendered = Native.call("legura.content.render", { content_format: post["content_format"], body: post["body"], content_document: post["content_document"] })
  return { id: post["id"], title: post["title"], body: post["body"], status: post["status"], html: rendered.html }
}
