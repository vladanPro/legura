import { NewPostForm } from "@/components/NewPostForm"

page NewPost() {
  data title: String = loadNewPostTitle()
  data mediaAvailable: Bool = loadAdminMediaAvailability()
  return ASX {
    <Head>
      <Link
        rel="stylesheet"
        href="/content-editor/60e28caa76c3edae1e513847b9530f4f0fb17f987a88b422132fbb521600e5fc/editor.css"
      />
      <Script src="/content-editor/host.js" type="module" />
    </Head>
    <NewPostForm
      title={title}
      format="legura-richtext"
      submitAction={action CreatePost}
      mediaAvailable={mediaAvailable}
    />
  }
}
