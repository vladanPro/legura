import { Card } from "@axonyx/ui/foundry/Card"
import { Badge } from "@axonyx/ui/foundry/Badge"
import { Button } from "@axonyx/ui/foundry/Button"
import { Select } from "@axonyx/ui/foundry/Select"
import { Input } from "@axonyx/ui/foundry/Input"
import { AdminFrame } from "@/components/AdminFrame"
import { AdminPageHeader } from "@/components/AdminPageHeader"
import { Table } from "@axonyx/ui/foundry/Table"
import { TableCaption } from "@axonyx/ui/foundry/TableCaption"
import { TableHead } from "@axonyx/ui/foundry/TableHead"
import { TableBody } from "@axonyx/ui/foundry/TableBody"
import { TableRow } from "@axonyx/ui/foundry/TableRow"
import { TableHeaderCell } from "@axonyx/ui/foundry/TableHeaderCell"
import { TableCell } from "@axonyx/ui/foundry/TableCell"

page ManagePosts() {
  data listing: AdminPostPage = loadAdminPosts(query.status ?? "all", query.page ?? "1", query.q ?? "")
  const posts = listing.posts
  return ASX {
    <AdminFrame section="posts">
      <section class="legura-posts">
        <AdminPageHeader title="Posts" description="Draft privately, publish when ready.">
          <a class="ax-button" data-variant="primary" href="/admin/posts/new">New post</a>
        </AdminPageHeader>
        <nav aria-label="Post collections" class="legura-links">
          <a href="/admin/posts" aria-current={listing.status != "trash"}>Posts</a>
          <a href="/admin/posts?status=trash" aria-current={listing.status == "trash"}>Trash</a>
        </nav>
        <form method="get" action="/admin/posts" class="legura-post-filters legura-form">
          <div class="legura-post-filter-field">
            <label for="post-search">Search titles</label>
            <Input type="search" id="post-search" name="q" value={listing.search} maxlength="200" />
          </div>
          <div class="legura-post-filter-field">
            <label for="post-status">Filter status</label>
            <Select id="post-status" name="status">
              <option value="all" selected={listing.status == "all"}>All posts</option>
              <option value="draft" selected={listing.status == "draft"}>Draft</option>
              <option value="published" selected={listing.status == "published"}>Published</option>
              <option value="trash" selected={listing.status == "trash"}>Trash</option>
            </Select>
          </div>
          <Button type="submit" variant="secondary">Apply filters</Button>
          <If when={listing.status != "all" || listing.search != ""}>
            <a class="legura-filter-reset" href="/admin/posts">Reset filters</a>
          </If>
        </form>
        <p class="legura-hint">{listing.total + " matching posts"}</p>
        <If when={!posts && listing.status == "all" && listing.search == ""}>
          <Card title="No posts yet">
            <p>Create your first draft. It stays private until published.</p>
          </Card>
        </If>
        <If when={!posts && listing.status == "trash" && listing.search == ""}>
          <Card title="Trash is empty">
            <p>Posts moved to Trash are kept until you restore or permanently delete them.</p>
          </Card>
        </If>
        <If when={!posts && (listing.search != "" || listing.status == "draft" || listing.status == "published")}>
          <Card title="No matching posts">
            <p>No titles match these filters. Change the search or reset the filters.</p>
            <a href="/admin/posts">Show all posts</a>
          </Card>
        </If>
        <If when={posts}>
          <Table
            class="legura-posts-table"
            role="region"
            aria-label="Scrollable posts table"
            tabindex="0"
            zebra="true"
          >
            <TableCaption>Your posts</TableCaption>
            <TableHead>
              <TableRow>
                <TableHeaderCell>Title and URL slug</TableHeaderCell>
                <TableHeaderCell>Status</TableHeaderCell>
                <TableHeaderCell>Author</TableHeaderCell>
                <TableHeaderCell>Created (UTC)</TableHeaderCell>
                <TableHeaderCell>Actions</TableHeaderCell>
              </TableRow>
            </TableHead>
            <TableBody>
              <Each items={posts} as="post">
                <TableRow>
                  <TableHeaderCell scope="row">
                    <If when={listing.status == "trash"}>
                      <strong>{post.title}</strong>
                    </If>
                    <If when={listing.status != "trash"}>
                      <a class="legura-post-title" href={"/admin/posts/" + post.id + "/edit"}>{post.title}</a>
                    </If>
                    <p class="legura-hint">{post.slug}</p>
                  </TableHeaderCell>
                  <TableCell>
                    <If when={listing.status == "trash"}>
                      <Badge>Trash</Badge>
                    </If>
                    <If when={listing.status != "trash"}>
                      <Badge>{post.status}</Badge>
                    </If>
                  </TableCell>
                  <TableCell>{post.author ?? "Unknown"}</TableCell>
                  <TableCell>
                    <If when={(post.created_at ?? "") != ""}>
                      <time datetime={post.created_at ?? ""}>{post.created_date}</time>
                    </If>
                    <If when={(post.created_at ?? "") == ""}>Unknown</If>
                  </TableCell>
                  <TableCell>
                    <If when={listing.status != "trash"}><a
                        class="legura-post-edit"
                        href={"/admin/posts/" + post.id + "/edit"}
                        aria-label={"Edit post: " + post.title}
                      >Edit post</a></If>
                    <If when={listing.status == "trash"}>
                      <div class="legura-form-actions">
                        <form method="post" action={action RestorePost}>
                          <input type="hidden" name="id" value={post.id} />
                          <Button type="submit" variant="secondary">Restore as draft</Button>
                        </form>
                        <a href={"/admin/posts/" + post.id + "/delete"}>Delete permanently</a>
                      </div>
                    </If>
                  </TableCell>
                </TableRow>
              </Each>
            </TableBody>
          </Table>
        </If>
        <nav class="legura-post-pagination" aria-label="Posts pages">
          <If when={listing.page > 1}>
            <form method="get" action="/admin/posts">
              <input type="hidden" name="q" value={listing.search} />
              <input type="hidden" name="status" value={listing.status} />
              <input type="hidden" name="page" value={listing.page - 1} />
              <Button type="submit" variant="secondary">Previous page</Button>
            </form>
          </If>
          <span>{"Page " + listing.page}</span>
          <If when={listing.page * 10 < listing.total}>
            <form method="get" action="/admin/posts">
              <input type="hidden" name="q" value={listing.search} />
              <input type="hidden" name="status" value={listing.status} />
              <input type="hidden" name="page" value={listing.page + 1} />
              <Button type="submit" variant="secondary">Next page</Button>
            </form>
          </If>
        </nav>
      </section>
    </AdminFrame>
  }
}
