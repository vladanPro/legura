import { Card } from "@axonyx/ui/foundry/Card"
import { Badge } from "@axonyx/ui/foundry/Badge"
import { Button } from "@axonyx/ui/foundry/Button"
import { Select } from "@axonyx/ui/foundry/Select"
import { AdminFrame } from "@/components/AdminFrame"
import { Table } from "@axonyx/ui/foundry/Table"
import { TableCaption } from "@axonyx/ui/foundry/TableCaption"
import { TableHead } from "@axonyx/ui/foundry/TableHead"
import { TableBody } from "@axonyx/ui/foundry/TableBody"
import { TableRow } from "@axonyx/ui/foundry/TableRow"
import { TableHeaderCell } from "@axonyx/ui/foundry/TableHeaderCell"
import { TableCell } from "@axonyx/ui/foundry/TableCell"

page ManagePosts() {
  data listing: AdminPostPage = loadAdminPosts(query.status ?? "all", query.page ?? "1")
  const posts = listing.posts
  return ASX {
    <AdminFrame section="posts">
    <section class="legura-posts">
      <header class="legura-page-heading">
        <div><h1>Posts</h1><p>Draft privately, publish when ready.</p></div>
        <a class="ax-button" data-variant="primary" href="/admin/posts/new">New post</a>
      </header>
      <form method="get" action="/admin/posts" class="legura-post-filters legura-form">
        <label for="post-status">Filter status</label>
        <Select id="post-status" name="status">
          <option value="all" selected={listing.status == "all"}>All posts</option>
          <option value="draft" selected={listing.status == "draft"}>Draft</option>
          <option value="published" selected={listing.status == "published"}>Published</option>
        </Select>
        <Button type="submit" variant="secondary">Apply filter</Button>
      </form>
      <p class="legura-hint">{listing.total + " matching posts"}</p>
      <If when={!posts && listing.status == "all"}><Card title="No posts yet"><p>Create your first draft. It stays private until published.</p></Card></If>
      <If when={!posts && listing.status != "all"}><Card title="No matching posts"><p>There are no posts with this status.</p><a href="/admin/posts">Show all posts</a></Card></If>
      <If when={posts}>
        <Table class="legura-posts-table" role="region" aria-label="Scrollable posts table" tabindex="0" zebra="true">
          <TableCaption>Your posts</TableCaption>
          <TableHead><TableRow><TableHeaderCell>Title and URL slug</TableHeaderCell><TableHeaderCell>Status</TableHeaderCell><TableHeaderCell>Actions</TableHeaderCell></TableRow></TableHead>
          <TableBody>
            <Each items={posts} as="post">
              <TableRow>
                <TableHeaderCell scope="row"><a class="legura-post-title" href={"/admin/posts/" + post.id + "/edit"}>{post.title}</a><p class="legura-hint">{post.slug}</p></TableHeaderCell>
                <TableCell><Badge>{post.status}</Badge></TableCell>
                <TableCell><a class="legura-post-edit" href={"/admin/posts/" + post.id + "/edit"} aria-label={"Edit post: " + post.title}>Edit post</a></TableCell>
              </TableRow>
            </Each>
          </TableBody>
        </Table>
      </If>
      <nav class="legura-post-pagination" aria-label="Posts pages">
        <If when={listing.page > 1}><a href={"/admin/posts?status=" + listing.status + "&page=" + (listing.page - 1)}>Previous page</a></If>
        <span>{"Page " + listing.page}</span>
        <If when={listing.page * 10 < listing.total}><a href={"/admin/posts?status=" + listing.status + "&page=" + (listing.page + 1)}>Next page</a></If>
      </nav>
    </section>
    </AdminFrame>
  }
}
