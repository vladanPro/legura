export type Administrator {
  id: String
  email: String
  role: String
}
export type AdminOverview {
  administrator: Administrator
  total: Number
  drafts: Number
  published: Number
  trashedPosts: Number
  trashedPages: Number
}
export query loadAdministrator() -> Administrator {
  require Auth.subject else forbidden()
  data user = db.legura_users.where({ id: Auth.subject }).first()
  require user else forbidden()
  require user["role"] == "admin" else forbidden()
  return user
}
export query loadAdminMediaAvailability() -> Bool {
  require Auth.subject else forbidden()
  data administrator = db.legura_users.where({ id: Auth.subject }).first()
  require administrator else forbidden()
  require administrator["role"] == "admin" else forbidden()
  data media = Native.call("legura.media.availability", null)
  return media.available
}
export query loadAdminOverview() -> AdminOverview {
  require Auth.subject else forbidden()
  data administrator = db.legura_users.where({ id: Auth.subject }).first()
  require administrator else forbidden()
  require administrator["role"] == "admin" else forbidden()
  data rows = db.query("SELECT COUNT(CASE WHEN trashed = 0 THEN 1 END) AS total, COUNT(CASE WHEN trashed = 0 AND status = 'draft' THEN 1 END) AS drafts, COUNT(CASE WHEN trashed = 0 AND status = 'published' THEN 1 END) AS published, COUNT(CASE WHEN trashed = 1 THEN 1 END) AS trashed_posts, (SELECT COUNT(*) FROM legura_pages WHERE trashed = 1) AS trashed_pages FROM legura_posts")
  data counts = rows[0]
  return { administrator: administrator, total: counts["total"], drafts: counts["drafts"], published: counts["published"], trashedPosts: counts["trashed_posts"], trashedPages: counts["trashed_pages"] }
}
