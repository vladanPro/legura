action CreatePage(title: String, slug: String, body: String) {
  data administrator = loadAdministrator()
  require input.title != "" && input.title.length <= 160 else invalid({ title: "Enter a title of at most 160 characters." })
  require input.slug != "" && input.slug.length <= 120 else invalid({ slug: "Enter a URL slug of at most 120 characters." })
  data slugCheck = db.query("SELECT CASE WHEN ? NOT GLOB '*[^a-z0-9-]*' AND ? NOT GLOB '-*' AND ? NOT GLOB '*-' THEN 1 ELSE 0 END AS allowed", input.slug, input.slug, input.slug)
  require slugCheck[0]["allowed"] == 1 else invalid({ slug: "Use lowercase letters, digits and internal hyphens." })
  data existing = db.legura_pages.where({ slug: input.slug }).first()
  require existing == null else invalid({ slug: "This page URL is already in use." })
  data prepared = Native.call("legura.content.prepare", { content_format: "plain-text", body: input.body, content_document: "" })
  require prepared.columns != null else invalid(prepared.errors)
  data id = Uuid.new()
  db.legura_pages.insert({ id: id, title: input.title, slug: input.slug, body: prepared.columns.body, status: "draft" })
  return redirect("/admin/pages")
}
