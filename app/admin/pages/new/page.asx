import { AdminFrame } from "@/components/AdminFrame"
import { SitePageFields } from "@/components/SitePageFields"
import { Card } from "@axonyx/ui/foundry/Card"
import { Field } from "@axonyx/ui/foundry/Field"
import { FieldLabel } from "@axonyx/ui/foundry/FieldLabel"
import { Input } from "@axonyx/ui/foundry/Input"

page NewSitePage() {
  data mediaAvailable: Bool = loadAdminMediaAvailability()
  return ASX {
    <AdminFrame section="pages" mediaAvailable={mediaAvailable}>
      <Card title="New page">
        <form
          method="post"
          action={action CreatePage}
          data-ax-retain-fields="title,slug,body"
          class="legura-form"
        >
          <SitePageFields />
          <Field htmlFor="slug">
            <FieldLabel htmlFor="slug">URL slug</FieldLabel>
            <Input
              id="slug"
              name="slug"
              required="true"
              maxlength="120"
              describedBy="page-slug-hint page-slug-error"
            />
            <p id="page-slug-hint" class="legura-hint">For example, o-nama becomes /pages/o-nama. This URL is fixed after creation.</p>
            <p
              id="page-slug-error"
              class="ax-field__error"
              data-ax-field-error="slug"
              aria-live="polite"
            ></p>
          </Field>
          <div class="legura-form-actions">
            <button type="submit" class="ax-button" data-variant="primary">Save draft</button>
            <a href="/admin/pages">Cancel</a>
          </div>
        </form>
      </Card>
    </AdminFrame>
  }
}
