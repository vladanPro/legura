export type SitePageSummary {
  id: String
  title: String
  slug: String
  status: String
}

export type SitePageListing {
  items: SitePageSummary[]
  page: Number
  total: Number
}

export query loadSitePages(page: String = "1") -> SitePageListing {
  require Auth.subject else forbidden()
  data administrator = db.legura_users.where({ id: Auth.subject }).first()
  require administrator else forbidden()
  require administrator["role"] == "admin" else forbidden()
  data filters = Native.call("legura.posts.filters", { status: "all", page: input.page, search: "" })
  data counts = db.query("SELECT COUNT(*) AS total FROM legura_pages")
  data pagination = Native.call("legura.pagination", { total: counts[0]["total"], requested_page: filters.requested_page, page_size: 10 })
  data items = db.query("SELECT id, title, slug, status FROM legura_pages ORDER BY title, id LIMIT ? OFFSET ?", pagination.page_size, pagination.offset)
  return { items: items, page: pagination.page, total: counts[0]["total"] }
}

export type SitePage {
  id: String
  title: String
  slug: String
  body: String
  status: String
}

export query loadSitePage(id: String) -> SitePage {
  require Auth.subject else forbidden()
  data administrator = db.legura_users.where({ id: Auth.subject }).first()
  require administrator else forbidden()
  require administrator["role"] == "admin" else forbidden()
  data entry = db.legura_pages.where({ id: input.id }).first()
  require entry else notFound()
  return entry
}
