export type SitePageSummary {
  id: String
  title: String
  slug: String
  status: String
}

export type SitePageListing {
  items: SitePageSummary[]
  page: Number
  total: Number
  trash: Bool
  status: String
  search: String
  can_delete: Bool
}

export query loadSitePages(page: String = "1", status: String = "", search: String = "") -> SitePageListing {
  require Auth.subject else forbidden()
  data administrator = db.legura_users.where({ id: Auth.subject }).first()
  require administrator else forbidden()
  data allowed = Native.call("legura.auth.allows", { role: administrator["role"], capability: "manage_content" })
  require allowed else forbidden()
  data filters = Native.call("legura.posts.filters", { status: input.status, page: input.page, search: input.search })
  data counts = db.query("SELECT COUNT(*) AS total FROM legura_pages WHERE trashed = (? = 'trash') AND instr(lower(title), lower(?)) > 0", filters.status, filters.search)
  data pagination = Native.call("legura.pagination", { total: counts[0]["total"], requested_page: filters.requested_page, page_size: 10 })
  data items = db.query("SELECT id, title, slug, status FROM legura_pages WHERE trashed = (? = 'trash') AND instr(lower(title), lower(?)) > 0 ORDER BY title, id LIMIT ? OFFSET ?", filters.status, filters.search, pagination.page_size, pagination.offset)
  return { items: items, page: pagination.page, total: counts[0]["total"], trash: filters.status == "trash", status: filters.status, search: filters.search, can_delete: administrator["role"] == "admin" }
}

export type SitePage {
  id: String
  title: String
  slug: String
  body: String
  status: String
}

export query loadSitePage(id: String) -> SitePage {
  require Auth.subject else forbidden()
  data administrator = db.legura_users.where({ id: Auth.subject }).first()
  require administrator else forbidden()
  data allowed = Native.call("legura.auth.allows", { role: administrator["role"], capability: "manage_content" })
  require allowed else forbidden()
  data entry = db.legura_pages.where({ id: input.id, trashed: 0 }).first()
  require entry else notFound()
  return entry
}
