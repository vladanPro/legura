AX_SECRET_DB_URL=sqlite://data/legura.db
AX_SECRET_DB_DIALECT=sqlite
# Set independent random secrets before starting. Do not commit your .env.
AX_SECRET_SESSION_KEY=
AX_SECRET_SETUP_TOKEN=
# Local HTTP only. Set true behind production HTTPS.
AX_SECRET_SESSION_COOKIE_SECURE=false

# Media is opt-in. Never place private media in public/ or dist/.
AX_SECRET_MEDIA_DRIVER=disabled
# To enable the local adapter, replace disabled with local, provision a private
# existing directory and set BOTH entries below. Uses AX_SECRET_DB_URL above.
# AX_SECRET_MEDIA_ROOT=/private/legura/media
# AX_SECRET_MEDIA_STORE_ID=local-media
